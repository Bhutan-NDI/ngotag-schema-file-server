{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-write=/app/schemas --watch server.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-write=/app/schemas server.ts",
    "cache": "deno cache --lock=deno.lock --frozen=false server.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check",
    "docker-start": "deno run --allow-net --allow-env --allow-read --allow-write=/app/schemas /app/server.ts"
  },
  "imports": {
    "std/": "https://deno.land/std@0.210.0/",
    "oak/": "https://deno.land/x/oak@v12.6.1/",
    "cors/": "https://deno.land/x/cors@v1.2.2/",
    "jwt/": "https://deno.land/x/djwt@v3.0.1/",
    "jwt-middleware/": "https://deno.land/x/oak_middleware_jwt@2.2.2/"
  },
  "lint": {
    "include": ["**/*.ts"],
    "exclude": ["**/*.test.ts", "schemas/"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "include": ["**/*.ts"],
    "exclude": ["schemas/"],
    "options": {
      "useTabs": false,
      "lineWidth": 80,
      "indentWidth": 2,
      "singleQuote": true,
      "proseWrap": "preserve"
    }
  },
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  }
}
